# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Data (never commit raw training dataset)
data/

# Model weights
weights/*.pt
weights/*.onnx
weights/*.h5

# Allow tracking trained best_model.pt (21.95 MB)
!weights/best_model.pt

# Ignore large raw .npy arrays to avoid hitting GitHub 100MB packfile limit
*.npy

# Outputs (allow committing metrics, plots, and test output PNGs)
!outputs/
!outputs/before_after_comparison.png
!outputs/val_outputs/metrics.json
!outputs/test_outputs/
!outputs/test_outputs/*.png
!outputs/test_outputs/metrics.json

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# OS
.DS_Store
__MACOSX/
Thumbs.db

# IDE
.vscode/
.idea/

# Virtualenv
venv/
env/
.env
